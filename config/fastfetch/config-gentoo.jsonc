{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "magenta",
            "2": "white"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "brightColor": false,
        "size": {
            "ndigits": 1
        },
        "key": {
            "width": 12
        },
        "color": {
            "keys": "light_black",
            "output": "default"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1;magenta}{user-name}{#}{#light_black}@{#}{#1}{host-name}{#}"
        },
        {
            "type": "os",
            "key": "{#magenta}{#keys}  os",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "{#magenta}{#keys}  kernel",
            "format": "{release}"
        },
        {
            "type": "wm",
            "key": "{#magenta}{#keys}  wm",
            "format": "{pretty-name}{?protocol-name} {#light_black}({protocol-name}){#}{?}"
        },
        {
            "type": "packages",
            "key": "{#magenta}󰏖{#keys}  pkgs",
            "format": "{emerge} {#light_black}emerge{#}{?flatpak-all}{#light_black} · {#}{flatpak-all} {#light_black}flatpak{#}{?}"
        },
        {
            "type": "shell",
            "key": "{#magenta}{#keys}  shell",
            "format": "{pretty-name} {#light_black}{version}{#}"
        },
        {
            "type": "uptime",
            "key": "{#magenta}󰅐{#keys}  uptime"
        },
        {
            "type": "memory",
            "key": "{#magenta}{#keys}  memory",
            "format": "{used} {#light_black}/{#} {total} {#light_black}({percentage}{#light_black}){#}"
        },
        {
            "type": "custom",
            "format": "{#red}  {#green}  {#yellow}  {#blue}  {#magenta}  {#cyan}{#}"
        }
    ]
}
