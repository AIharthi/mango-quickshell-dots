#!/bin/sh
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=mango
export XDG_SESSION_DESKTOP=mango
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland"
export QT_QUICK_CONTROLS_STYLE="Basic"
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_THEME="${XCURSOR_THEME:-catppuccin-mocha-dark-cursors}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    MANGO_BIN="$(command -v mango || echo /usr/bin/mango)"
    if [ ! -x "$MANGO_BIN" ]; then
        echo "mango-session: cannot find executable 'mango' binary in PATH" >&2
        exit 1
    fi
    exec dbus-run-session -- "$MANGO_BIN" "$@"
fi
MANGO_BIN="$(command -v mango || echo /usr/bin/mango)"
if [ ! -x "$MANGO_BIN" ]; then
    echo "mango-session: cannot find executable 'mango' binary in PATH" >&2
    exit 1
fi
exec "$MANGO_BIN" "$@"
